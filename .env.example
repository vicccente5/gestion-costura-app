# =============================================
# Variables de entorno — Gestión Costura App
# =============================================
# Copiar este archivo como .env y completar los valores reales
# El archivo .env NUNCA debe aparecer en git

# --- Servidor ---
SERVER_PORT=8080
GIN_MODE=debug  # Cambiar a "release" en producción

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=costura_user
DB_PASSWORD=costura_password_dev
DB_NAME=costura_db
DB_SSLMODE=disable  # Cambiar a "require" en producción

# --- JWT ---
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_POR_UN_SECRET_DE_AL_MENOS_32_CARACTERES_ALEATORIOS
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# --- Migraciones ---
# URL completa para golang-migrate CLI
# Formato: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://costura_user:costura_password_dev@localhost:5432/costura_db?sslmode=disable
